# Example .env for Study Planner server
# Replace with your MongoDB Atlas connection string (do NOT commit real credentials to git)

# Option A (recommended - SRV connection):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/studyPlanner?retryWrites=true&w=majority

# Option B (non-SRV, include hosts):
# MONGODB_URI=mongodb://<username>:<password>@ac-xxxxx-shard-00-00.xxxxxx.mongodb.net:27017,ac-xxxxx-shard-00-01.xxxxxx.mongodb.net:27017,ac-xxxxx-shard-00-02.xxxxxx.mongodb.net:27017/studyPlanner?ssl=true&authSource=admin&retryWrites=true&w=majority

# JWT secret
JWT_SECRET=your_jwt_secret_key

# Server port
PORT=5000

# Frontend URL for CORS (set to your Vercel deployment URL in production)
FRONTEND_URL=https://study-planner-tau.vercel.app

# Environment
NODE_ENV=production

# Notes:
# - If you see errors about TLS/SSL or SRV lookup, make sure your current machine IP is added to the Atlas Network Access list (Access > Network Access).
# - For development you can temporarily allow access from anywhere (0.0.0.0/0) but this is not recommended for production.
# - Ensure the password is URL-encoded (e.g., use %40 for @)
# - FRONTEND_URL must match your deployed frontend URL for CORS to work correctly
